)
threshold = 0.3
mode<- "minPercDataInAnyGroup"
gruposUnicos <- unique(dfGrupos$Groups)
gruposUnicos
# Función para calcular porcentaje de NA en un grupo para una proteína
checkByRow <- function(valores, umbral, mode) {
resultadosGrupo <- sapply(gruposUnicos, function(g) {
idx <- dfGrupos |>
dplyr::filter(Groups == g) |>
dplyr::pull(Samples)
porcentajeNA <- mean(is.na(valores[idx]))
porcentajeData <- mean(!is.na(valores[idx]))
totalData <- sum(!is.na(valores[idx]))
if (mode == "maxPercNAByGroup") { # MODO 1: Si el % de NA en el grupo es mayor del permitido, esa prot == FALSE, sino TRUE
return(porcentajeNA <= umbral)
}
if (mode == "minDataByGroup") { # MODO 2: Si hay menos datos de cuantificación que los definidos por el umbral en el grupo, esa prot fuera
return(totalData >= umbral)
}
if (mode == "minPercDataInAnyGroup") { # MODO 3: Si el % de datos completos en el grupo es mayor del permitido, esa prot == TRUE, sino FALSE
return(porcentajeData >= umbral)
}
})
if (mode %in% c("maxPercNAByGroup", "minDataByGroup")) { # Si en algún grupo es FALSE la proteína, se va (todo debe ser TRUE)
return(all(resultadosGrupo))
}
if (mode == "minPercDataInAnyGroup") { # Si en algún grupo es TRUE la proteína, se queda
return(any(resultadosGrupo))
}
}
