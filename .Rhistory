# Functions
library(ggplot2)
# lista_plots: list de objetos ggplot
getYrange <- function(p) {
b <- ggplot2::ggplot_build(p)
ys <- unlist(lapply(b$data, function(d) d$y), use.names = FALSE)
range(ys[is.finite(ys)], na.rm = TRUE)
}
getResultsByItem <- function(dfRaw, listaNorm, dm, item){
# just a common object
# dm <- as.data.frame(lista[[1]][["metadata"]])
# cat(item, "\n")
colnames(dm) <- c("Samples", "Groups")
grupos <- unique(dm$Groups)
numRows <- ceiling(length(listaNorm)/2)
empties <- replicate(numRows-3, ggplot() + theme_void(), simplify = FALSE)
# Starting with data extraction and metrics/graphs estimation...
if (item == "item0"){ # only item 0
empties <- c(Biomics::plotBarTI(data = dfRaw, interact = F)$grafico +
theme(axis.text.x = element_text(vjust = 0.5)), empties)
output <-  ggpubr::ggarrange(plotlist = empties, ncol = 1, nrow = numRows-2)
} else { # other items
# First extrating individual data and generating individual plots
a <<- 0
finalData <- lapply(listaNorm, function(datos){
a <<- a+1
# cat(a, "\n")
# cat(names(listaNorm)[a], "\n")
nome <- names(listaNorm)[a]
if (item == "item6"){
Biomics::plotBoxMulti(
base = datos, varResumen = colnames(datos),
interact = F, tituloX = nome, tituloY = "Intensity distribution"
)$grafico + theme(axis.text.x = element_text(angle = 65, vjust = 0.5))
} else if (item == "item5"){
Biomics::plotRLE(df = datos, normalizacion = nome, interact = F,
tituloX = nome)$grafico +
theme(axis.text.x = element_text(angle = 65, vjust = 0.5))
} else if (item == "item4"){
Biomics::plotMeanSD(df = datos, interact = F, tituloX = nome)$grafico
} else if (item == "item3"){
Biomics::plotMA(df = datos, dfGrupos = dm, gControl = grupos[1],
gCase = grupos[2], titulo = nome, limY = c(-200, 200),
showR2 = F, interact = F)$grafico
}
})
names(finalData) <- paste0("SimDataset_",1:length(finalData))
# Select ylim for MAplot after calculations
if (item == "item3"){
rangos <- lapply(finalData, getYrange)
ylimGlobal <- ceiling(max(abs(range(unlist(rangos), na.rm = TRUE)*1.1)))
# Aplicar el mismo límite Y a todos (sin recortar datos del todo)
finalData <- lapply(finalData, function(p) {
p  + coord_cartesian(ylim = c(-ylimGlobal, ylimGlobal))
})
}
# Mix plots into a single image or...
if (item %in% c("item3", "item4", "item5", "item6")){ # plot graphs together: MAplot, RLEplot, meanSDplot, TIboxplot
output <- ggpubr::ggarrange(plotlist = finalData,
ncol = 2, nrow = numRows)
} else if (item == "item1"){ # ...or generate other metrics with data for remaining items
empties <- c(Biomics::getPCV( # PVC
listData = listaNorm,
grupos = grupos,
dfGrupos = dm,
grafico = T,
interact = F
)$grafico, empties)
output <-  ggpubr::ggarrange(plotlist = empties, ncol = 1, nrow = numRows-2)
} else if (item =="item2"){ # Correlation
allVectorsCorr <- lapply(
listaNorm,
Biomics::getPooledCor,
dfGrupos = dm,
metodo = "spearman")
dfPlot <- data.frame(sapply(allVectorsCorr, "length<-", max(lengths(allVectorsCorr))))
empties <- c(Biomics::plotBoxMulti(
base = dfPlot,
varResumen = colnames(dfPlot),
tituloX = "Normalizations", interact = F,
tituloY = "Spearman correlation")$grafico, empties)
output <- ggpubr::ggarrange(plotlist = empties, ncol = 1, nrow = numRows-2)
}
}
res <- list(output)
names(res) <- item
return(res)
}
df <- readxl::read_xlsx(path = "_Index.xlsx", sheet = 1, col_names = T)
# df$`Publication (DOI)` <- gsub(pattern = "DOI: ", replacement = "",
#                                x = df$`Publication (DOI)`, fixed = T)
urlDOI <- paste0("https://doi.org/", substr(x = df$`Publication (DOI)`, start = 6, stop = 50))
df$`Publication (DOI)` <- paste0(
"<a href='", urlDOI, "' target='_blank'>", df$`Publication (DOI)`,"</a>"
)
df <- df %>% arrange(Acquisition, `MS instrument`) %>% mutate(Number = 1:100)
DT::datatable(df, extensions = "Buttons", rownames = F, escape = F, filter = "top",
options = list(ordering = T, dom = "Bfrt", scrollY = '500px',
scrollX = T, pageLength = nrow(df),
# columnDefs = list(list(className = 'dt-center', targets = '_all')),
full_width = TRUE, rowCallback = DT::JS(js),
buttons = list(list(extend = "copy"),
list(extend = "csv"),
list(extend = "excel")))) #%>%
# DT::formatStyle(1, font = 'bold')
# allFiles <- list.files(path = "ProcessedDatasets/")
allFilesDDA <- df %>%
filter(Acquisition == "DDA") %>%
pull(ID) %>% paste0(., ".rds")
allFilesDDA <- "PXD076216.rds"
listGraphs <- sapply(allFilesDDA, function(i){
# cat("\n", i)
output <- readRDS(file = paste0(outDir, i))
# getResults(dfRaw = output$data, datos = output$dataLog, dm = output$dm)
resultado <- sapply(items,
getResultsByItem,
dfRaw = output$data,
listaNorm = output$listaNorm,
dm =  output$dm,
simplify = F,
USE.NAMES = T
)
return(resultado)
},simplify = F, USE.NAMES = T)
