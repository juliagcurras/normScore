fill = missingLabel
)
) +
ggplot2::geom_tile() +
ggplot2::scale_fill_manual(
values = c(
"Complete" = colorComplete,
"Missing" = colorMissing
),
name = NULL
) +
ggplot2::labs(
title = title,
subtitle = paste0(
"Global missing data: ",
round(globalMissing, 2),
"%"
),
x = "Samples (% missing)",
y = "Proteins"
) +
ggplot2::theme_minimal(base_size = sizeText) +
ggplot2::theme(
axis.text.x = ggplot2::element_text(
angle = 45,
hjust = 1,
vjust = 1
),
axis.text.y = element_blank(),
panel.grid = ggplot2::element_blank(),
legend.position = "bottom"
)
) |>
plotly::layout(
title = list(
text = paste0(
"<b>", p$labels$title, "</b>",
"<br>",
"<sup>", p$labels$subtitle, "</sup>"
)
)
)
plotMissingHeatmap <- function(
data,
colorComplete = "grey90",
colorMissing = "#08306B",
sizeText = 12,
title = "Missing data heatmap"
) {
data <- as.data.frame(data)
dfMissing <- data |>
dplyr::mutate(rowId = rownames(data)) |>
tidyr::pivot_longer(
cols = -rowId,
names_to = "variable",
values_to = "value"
) |>
dplyr::mutate(
rowId = factor(rowId, levels = rev(rownames(data))),
missing = is.na(value),
missingLabel = dplyr::if_else(missing, "Missing", "Complete")
)
missingByColumn <- dfMissing |>
dplyr::group_by(variable) |>
dplyr::summarise(
percentMissing = mean(missing) * 100,
.groups = "drop"
)
missingByColumn <- missingByColumn |>
dplyr::mutate(
variableLabel = paste0(
variable,
" (",
round(percentMissing, 1),
"%)"
)
)
dfMissing <- dfMissing |>
dplyr::left_join(
missingByColumn,
by = "variable"
) |>
dplyr::mutate(
variableLabel = factor(
variableLabel,
levels = missingByColumn$variableLabel
)
)
globalMissing <- mean(is.na(as.matrix(data))) * 100
plotly::ggplotly(ggplot2::ggplot(
dfMissing,
ggplot2::aes(
x = variableLabel,
y = rowId,
fill = missingLabel
)
) +
ggplot2::geom_tile() +
ggplot2::scale_fill_manual(
values = c(
"Complete" = colorComplete,
"Missing" = colorMissing
),
name = NULL
) +
ggplot2::labs(
title = title,
subtitle = paste0(
"Global missing data: ",
round(globalMissing, 2),
"%"
),
x = "Samples (% missing)",
y = "Proteins"
) +
ggplot2::theme_minimal(base_size = sizeText) +
ggplot2::theme(
axis.text.x = ggplot2::element_text(
angle = 45,
hjust = 1,
vjust = 1
),
axis.text.y = element_blank(),
panel.grid = ggplot2::element_blank(),
legend.position = "bottom"
)
) |>
plotly::layout(
title = list(
text = paste0(
"<b>", p$labels$title, "</b>",
"<br>",
"<sup>", p$labels$subtitle, "</sup>"
)
)
)
}
plotMissingHeatmap(data)
