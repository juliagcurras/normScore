expect_equal(result, 0)
})
test_that("rleMAPE handles missing values when enough data are available", {
mat <- matrix(
c(1,  1, NA,
2,  2,  2,
3, NA,  3,
4,  4,  4),
nrow = 4,
byrow = TRUE
)
result <- rleMAPE(mat)
expect_type(result, "double")
expect_length(result, 1)
expect_false(is.na(result))
expect_gte(result, 0)
})
