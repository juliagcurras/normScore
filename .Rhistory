allG <- apply(
X = combinaciones,
MARGIN = 1,
FUN = function(combinacion) {
# Groups
gType <- combinacion[["Type"]]
gState <- combinacion[["State"]]
# cat("\n\nStarting with ", gState, " and ", gType)
