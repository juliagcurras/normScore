dfPlot <- dfAll |>
dplyr::filter(Type == gType & State ==  gState)
# Plotting
violinPlot(
df = dfPlot,
yVar = iCovar,
groupVariable = "Embryo",
tituloY = paste0("Distribution of ", qcMetricsLabel[[iCovar]]),
titulo = paste0(gType, " and ", gState),
color = NULL
) +
ggplot2::ylim(c(0, maxY)) +
ggplot2::theme(legend.position = "none")
}
)
ggpubr::ggarrange(plotlist = allG, ncol = 2, nrow = 2)
},
simplify = F, USE.NAMES = T)
